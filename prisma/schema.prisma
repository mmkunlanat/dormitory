// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
}

model User {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  room      String
  phone     String?
  email     String?   @unique
  password  String?
  status    String    @default("ACTIVE") // ACTIVE, INACTIVE
  bills     Bill[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([room])
  @@index([status])
}

model Bill {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String    @db.ObjectId
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  month     String    // Format: YYYY-MM
  rent      Float
  water     Float
  electric  Float
  total     Float
  status    String    @default("PENDING") 
  // Status: PENDING (รอชำระ), PENDING_VERIFICATION (รอตรวจสอบ), PAID (ชำระแล้ว), CANCELLED (ยกเลิก)
  payments  Payment[]
  dueDate   DateTime?
  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, month])
  @@index([userId])
  @@index([status])
  @@index([month])
}

model Payment {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  billId        String    @db.ObjectId
  bill          Bill      @relation(fields: [billId], references: [id], onDelete: Cascade)
  slipUrl       String    // URL ของสลิปใน Cloudinary
  slipPublicId  String?   // Public ID ใน Cloudinary (สำหรับลบภาพ)
  ocrText       String?   // ข้อความที่อ่านได้จาก OCR
  note          String?   // หมายเหตุจากผู้ใช้
  amount        Float?    // จำนวนเงินที่โอน (ถ้าอ่านได้จาก OCR)
  status        String    @default("PENDING") 
  // Status: PENDING (รอตรวจสอบ), APPROVED (อนุมัติ), REJECTED (ปฏิเสธ)
  verifiedAt    DateTime? // เวลาที่ตรวจสอบ
  verifiedBy    String?   // ผู้ตรวจสอบ (admin username/id)
  rejectReason  String?   // เหตุผลที่ปฏิเสธ (ถ้า status = REJECTED)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([billId])
  @@index([status])
}

// ตัวอย่าง Admin User model (ถ้าต้องการ)
model Admin {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  username  String   @unique
  email     String   @unique
  password  String   // ควร hash ด้วย bcrypt
  name      String
  role      String   @default("ADMIN") // ADMIN, SUPER_ADMIN
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}